msgid "Settings"
msgstr "Indstillinger"

msgid "About"
msgstr "Om"

msgid "Boat Position Settings"
msgstr "Båd GPS – indstillinger"

msgid "Boat Position: About"
msgstr "Båd GPS: Om"

msgid "API"
msgstr "API"

msgid "API Key"
msgstr "API-nøgle"

msgid "Save API Key"
msgstr "Gem API-nøgle"

msgid "(defined in wp-config.php)"
msgstr "(defineret i wp-config.php)"

#. translators: %1$s and %2$s are code constant/file names
msgid "Remove the %1$s constant from %2$s to manage the key here instead."
msgstr "Fjern konstanten %1$s fra %2$s for at styre nøglen her i stedet."

#. translators: %s is the field name
msgid "Secret key sent by the router in the %s field. Use a long random string."
msgstr "Hemmelig nøgle sendt af routeren i feltet %s. Brug en lang, tilfældig streng."

msgid "About page not found."
msgstr "Om-siden blev ikke fundet."

