msgstr "Du skal være logget ind."

msgid "You do not have permission to edit trips."
msgstr "Du har ikke tilladelse til at redigere sejlture."

msgid "No position data available."
msgstr "Ingen positionsdata tilgængelige."

msgid "Trip not found."
msgstr "Sejlturen blev ikke fundet."

msgid "Name is required."
msgstr "Navn er påkrævet."

msgid "Invalid coordinates."
msgstr "Ugyldige koordinater."

msgid "Harbour not found."
msgstr "Havnen blev ikke fundet."

msgid "Invalid trip ids."
msgstr "Ugyldige sejltur-id'er."

msgid "Plan not found."
msgstr "Planen blev ikke fundet."

msgid "Failed to create plan."
msgstr "Planen kunne ikke oprettes."

msgid "Waypoint not found."
msgstr "Waypoint blev ikke fundet."

msgid "Name cannot be empty."
msgstr "Navn må ikke være tomt."

msgid "API key not configured on the server."
msgstr "API-nøgle er ikke konfigureret på serveren."

msgid "Unauthorized."
msgstr "Ikke godkendt."

msgid "Invalid or missing fields: lat, lon, speed (numeric) and gps_time (ISO 8601) are required."
msgstr "Ugyldige eller manglende felter: lat, lon, speed (numerisk) og gps_time (ISO 8601) er påkrævet."

msgid "lat out of range (-90 to 90)."
msgstr "lat er uden for område (-90 til 90)."

msgid "lon out of range (-180 to 180)."
msgstr "lon er uden for område (-180 til 180)."

msgid "speed cannot be negative."
msgstr "speed må ikke være negativ."

msgid "Failed to store position."
msgstr "Det lykkedes ikke at gemme positionen."

